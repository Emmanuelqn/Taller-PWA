# ============================================================================
# ARCHIVO DE EJEMPLO - Copiar a .env y completar valores
# Variables de entorno para DESARROLLO LOCAL y VERCEL
# ============================================================================

# ============================================================================
# BASE DE DATOS - Supabase PostgreSQL
# ============================================================================
# Obtener de: Supabase Dashboard > Settings > Database > Connection string
# IMPORTANTE: Si tu contraseña tiene caracteres especiales, codifícalos:
#   # = %23
#   @ = %40
#   etc.

# URL de conexión con pooler (para conexiones serverless - REQUERIDO para Vercel)
# Usar puerto 6543 y agregar ?pgbouncer=true para pooler
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ============================================================================
# SUPABASE AUTH & STORAGE
# ============================================================================
# Obtener de: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================================
# OPENROUTER API (para IA/LLM)
# ============================================================================
# Obtener de: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# ============================================================================
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# ============================================================================
# NODE_ENV se configura automáticamente en Vercel
# NODE_ENV="production"
